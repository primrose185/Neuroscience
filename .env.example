# Google Custom Search Configuration
# Get your Search Engine ID from: https://programmablesearchengine.google.com/
# See GOOGLE_SEARCH_SETUP.md for detailed setup instructions
VITE_GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Enable or disable Google Search feature (set to 'true' to enable)
# When disabled, only local search will be available
VITE_ENABLE_GOOGLE_SEARCH=false

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "git lfs install && git lfs pull && git lfs ls-files && echo 'lfs pull done' && yarn build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
} 